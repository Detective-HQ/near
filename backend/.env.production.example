# Production environment for the Go API and worker (managed cloud PostgreSQL).
# Copy into your host's secret/env manager. Never commit real values.

APP_ENV=production
HTTP_ADDR=:8081
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Database (Neon / Supabase / RDS / Railway / any managed PostgreSQL) ----
# TLS is mandatory in production: sslmode must be require, verify-ca or verify-full.
# Use the POOLED endpoint here and set DB_PGBOUNCER=true when it is PgBouncer
# (Neon "-pooler" host, Supabase port 6543). Use the DIRECT endpoint only for `migrate`.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_PGBOUNCER=false
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# Redis is optional (worker catalogue lock). Use rediss:// for TLS.
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ---- Edge / security ----
# Networks of your load balancer / Next.js proxy whose X-Forwarded-For is trusted.
TRUSTED_PROXY_CIDRS=10.0.0.0/8
# Only if browsers call the API directly (not through the Next.js proxy).
CORS_ALLOWED_ORIGINS=
AUTH_REQUIRED=false
AUTH_SESSION_TTL_MINUTES=1440
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
HTTP_MAX_BODY_BYTES=65536
# Prometheus /metrics: set a long random token; scrapers send "Authorization: Bearer <token>".
METRICS_TOKEN=
# Worker metrics listener (optional), e.g. :9090
WORKER_METRICS_ADDR=
# Writable directory for raw analytics snapshots (containers: /tmp is fine).
ANALYTICS_SNAPSHOT_DIR=/tmp/udi-snapshots

# ---- Data and swaps ----
# live = DeFiLlama market data + trading analytics; fixture = illustrative data.
MARKET_DATA_MODE=live
# demo = simulation quotes only. live requires ONECLICK_JWT.
SWAP_QUOTE_MODE=demo
ENABLE_LIVE_EXECUTION=false
ONECLICK_JWT=
ONECLICK_QUOTE_PUBLIC_KEY=
