# Go backend configuration.
#
# The backend reads this file when it is started from the backend directory.
# Existing process environment variables always win over values in .env.

APP_ENV=local

# HTTP server. HTTP_ADDR takes precedence over the legacy API_HOST/API_PORT.
HTTP_ADDR=127.0.0.1:8081
HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=30
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_MAX_HEADER_BYTES=1048576

# PostgreSQL. DATABASE_URL is optional in local mode and required elsewhere.
# DATABASE_URL=postgres://udi:change-me@localhost:5432/udi
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT_SECONDS=5
DB_PING_TIMEOUT_SECONDS=2
#
# Apply or inspect the embedded schema (reads DATABASE_URL):
#   go run ./cmd/migrate up
#   go run ./cmd/migrate status
#   go run ./cmd/migrate check    # CI drift check: database must match the binary
#
# Repository integration tests use TEST_DATABASE_URL when set. Otherwise they
# auto-start postgres:16-alpine through testcontainers and skip if Docker is
# unavailable. The schema is created in a throwaway PostgreSQL schema per test.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/udi_test?sslmode=disable
#   go test ./...

# Redis.
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT_SECONDS=2

# NEAR Intents 1Click. Keep the JWT server-side; never expose it to the browser.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
ONECLICK_TIMEOUT_MS=10000
ONECLICK_QUOTE_DEADLINE_SECONDS=180
ONECLICK_MAX_RESPONSE_BYTES=2097152
ONECLICK_QUOTE_PUBLIC_KEY=

# Execution gate. Live execution requires ONECLICK_JWT and quote mode "live".
ENABLE_LIVE_EXECUTION=false
SWAP_QUOTE_MODE=live

# Market data and catalogue caching.
MARKET_DATA_MODE=live
MARKET_DATA_TTL_SECONDS=300
MARKET_DATA_TIMEOUT_MS=10000
ASSET_CATALOGUE_TTL_SECONDS=300

# Swap status worker.
SWAP_STATUS_POLL_SECONDS=5
SWAP_STATUS_MAX_AGE_MINUTES=60
SWAP_STATUS_POLL_CONCURRENCY=10

# Security and HTTP edge.
# AUTH_REQUIRED=true forces wallet sign-in (POST /api/v1/auth/nonce + /verify)
# for quotes, swaps and activity. Swaps created by a signed-in wallet are only
# visible to that wallet even when this is false.
AUTH_REQUIRED=false
AUTH_SESSION_TTL_MINUTES=1440
# Exact origins allowed to call the API cross-origin (comma separated, no "*").
# Leave empty when the browser only reaches the API through the Next.js proxy.
CORS_ALLOWED_ORIGINS=
# Networks whose X-Forwarded-For is trusted (the Next.js proxy / load balancer).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
HTTP_MAX_BODY_BYTES=65536
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Where raw analytics snapshots are written (must be writable).
# ANALYTICS_SNAPSHOT_DIR=data/snapshots

# Structured logging.
LOG_LEVEL=info
LOG_FORMAT=json
