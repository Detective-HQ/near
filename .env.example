APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8081
NEXT_HOST=127.0.0.1
NEXT_PORT=3000
UDI_API_ORIGIN=http://127.0.0.1:8081
DATA_FILE=./data/udi.json
DEMO_MODE=true
SWAP_QUOTE_MODE=demo
MARKET_DATA_MODE=fixture
MARKET_DATA_TTL_SECONDS=300
MARKET_DATA_TIMEOUT_MS=10000
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# NEAR Intents partner JWT; keep server-side, never use NEXT_PUBLIC_.
ONECLICK_JWT=
# Base58 Ed25519 key for quote signature verification (optional; empty means signatureVerified=false).
ONECLICK_QUOTE_PUBLIC_KEY=
ONECLICK_TIMEOUT_MS=10000
ASSET_CATALOGUE_TTL_SECONDS=300
ONECLICK_QUOTE_DEADLINE_SECONDS=180
SWAP_STATUS_POLL_SECONDS=5
ENABLE_LIVE_EXECUTION=false
LOG_LEVEL=info
