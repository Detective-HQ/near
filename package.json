{
  "name": "universal-defi-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && go run -mod=vendor ./cmd/api",
    "build": "npm --prefix frontend run build && cd backend && go build -mod=vendor ./cmd/api",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "cd backend && go build -mod=vendor ./cmd/api",
    "start": "npm --prefix frontend run start",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:backend": "cd backend && go test -mod=vendor ./internal/httpapi ./internal/swap/domain",
    "check": "npm run typecheck && npm run test:backend"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
